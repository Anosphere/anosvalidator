# network/testnet.env: every value that is the same on every validator VM of
# the testnet. Committed; no secrets. npm start and the systemd unit load it
# first and .env, the machine file make-keys writes (the id, the database
# password, the key file), second, so .env wins where both name a variable:
#   node --env-file=network/testnet.env --env-file=.env src/server.js
#
# A value shown as "<fill in>" is filled by us once the address exists; the
# server refuses to start while one is still "<fill in>". Those values are in
# double quotes because scripts/setup-db.sh sources this file with sh, which
# would read a bare < as a redirection; Node strips the quotes.

# PostgreSQL on the VM itself, over TCP: the role and the database
# scripts/setup-db.sh creates. The role's password is in .env.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=anossoftware
PGDATABASE=anos

# Where the validator listens. The doorman in front of the VM holds the
# external IP and forwards to this port.
PORT=3000

# Time locks on guarded and vault accounts, in minutes: 10 and 20 on the
# testnet (a week and a month in production). A guarded or vault transfer
# may be dated at most LOCK_OFFSET_MINUTES more than its lock ahead; the
# wallet dates one the lock plus the offset ahead. The offset also bounds how
# far a fund proposal's createdAt may be from the validator's clock.
GUARDED_LOCK_MINUTES=10
VAULT_LOCK_MINUTES=20
LOCK_OFFSET_MINUTES=5

# Stakes, in whole anos: the least a transferToFund may stake for each
# purpose, and the stake an account must hold to have that role. The
# production values.
STAKE_MIN_DAO_VOTE_ANOS=10
STAKE_MIN_MODERATOR_ANOS=1000
STAKE_MIN_ATTESTOR_ANOS=1000
STAKE_MIN_GUARDIAN_ANOS=1000
STAKE_MIN_VALIDATOR_ANOS=50000
STAKE_MIN_MASTER_POD_ANOS=500000

# Guardian votes on fund proposals: the guardian stake behind one vote, in
# whole anos; the share of the votes cast a proposal needs to pass; how long
# a proposal is open for votes, in minutes (60 on the testnet, a week in
# production).
GUARDIAN_VOTE_ANOS=1000
GUARDIAN_VOTE_PERCENT=70
GUARDIAN_VOTE_MINUTES=60

# The masterpod, asked /get-anos-account on every create-account submission:
# its load balancer, scheme, host and port, no path.
MASTERPOD_URL="https://anocloud.com"

# The wallet's origin for CORS: scheme, host and port, no path; a
# comma-separated list when there is more than one.
WEB_ORIGIN="https://wallet.anocloud.com,https://attestor.wallet.anocloud.com,https://moderator.wallet.anocloud.com"

# How far a signed account-level request's timestamp may be from the
# validator's clock, each way, in seconds. Nonces are kept twice this long.
TIMESTAMP_WINDOW_SECONDS=120
