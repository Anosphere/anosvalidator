# network/testnet.env: every value that is the same on every validator VM of
# the testnet. Committed; no secrets. npm start and the systemd unit load it
# first and .env, the machine file make-keys writes (the id, the database
# password, the key file), second, so .env wins where both name a variable:
#   node --env-file=network/testnet.env --env-file=.env src/server.js
#
# A value shown as "<fill in>" is filled by us once the address exists; the
# server refuses to start while one is still "<fill in>". Those values are in
# double quotes because scripts/setup-db.sh sources this file with sh, which
# would read a bare < as a redirection; Node strips the quotes.

# PostgreSQL on the VM itself, over TCP: the role and the database
# scripts/setup-db.sh creates. The role's password is in .env.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=anossoftware
PGDATABASE=anos

# Where the validator listens. The doorman in front of the VM holds the
# external IP and forwards to this port.
PORT=3000

# Time locks on guarded and vault accounts, in minutes: a week and 30 days,
# the production values since 2026-11-12 (10 and 20 on the testnet before
# that), and an offset of 10 minutes (5 before). A guarded or vault transfer
# may be dated at most LOCK_OFFSET_MINUTES more than its lock ahead; the
# wallet dates one the lock plus the offset ahead. The offset also bounds how
# far a fund proposal's createdAt may be from the validator's clock, and
# since 2026-11-11 (docs/schemas.md section 27) the createdAt of every
# transfer without a lock: a plain, an assisted and an escrow transfer, a
# transferToFund and a break-glass move out of a spending or assisted
# account must be dated within the offset of the validator's clock, before
# or after. A cancel of an assisted transfer or of an escrow trade waits
# until its transfer is more than the offset old.
GUARDED_LOCK_MINUTES=10080
VAULT_LOCK_MINUTES=43200
LOCK_OFFSET_MINUTES=10

# Stakes, in whole anos: the least a transferToFund may stake for each
# purpose, and the stake an account must hold to have that role. The
# production values.
STAKE_MIN_DAO_VOTE_ANOS=10
STAKE_MIN_MODERATOR_ANOS=1000
STAKE_MIN_ATTESTOR_ANOS=1000
STAKE_MIN_GUARDIAN_ANOS=1000
STAKE_MIN_VALIDATOR_ANOS=50000
STAKE_MIN_MASTER_POD_ANOS=500000

# Guardian votes on fund proposals: the guardian stake behind one vote, in
# whole anos; the share of the votes cast a proposal needs to pass; how long
# a proposal is open for votes, in minutes: a week, the production value
# since 2026-11-12 (60 on the testnet before that).
GUARDIAN_VOTE_ANOS=1000
GUARDIAN_VOTE_PERCENT=70
GUARDIAN_VOTE_MINUTES=10080

# The masterpod, asked /get-anos-account on every create-account submission:
# its load balancer, scheme, host and port, no path.
MASTERPOD_URL="https://api.anocloud.com"

# The wallet's origin for CORS: scheme, host and port, no path; a
# comma-separated list when there is more than one.
WEB_ORIGIN="https://wallet.anocloud.com,https://attestor.wallet.anocloud.com,https://moderator.wallet.anocloud.com"

# How far a signed account-level request's timestamp may be from the
# validator's clock, each way, in seconds. Nonces are kept twice this long.
TIMESTAMP_WINDOW_SECONDS=120

# The calls between validators, and the catch-up, the ignore votes and the
# joining built on them (docs/schemas.md section 19). A call that gets no
# answer within VALIDATOR_CALL_TIMEOUT_SECONDS counts as no answer. An
# ignore vote may not leave fewer counted validators than
# IGNORE_FLOOR_PERCENT percent of the active registry rows. A joiner holds
# the leader's rounds for at most JOIN_HOLD_SECONDS. An originator that got
# no answer waits at most NO_ANSWER_WAIT_SECONDS for the vote before it
# sends once more. A chain chunk carries at most CHAIN_CHUNK_LINKS links and
# a page of held rows at most HELD_ROWS_PAGE rows.
VALIDATOR_CALL_TIMEOUT_SECONDS=10
IGNORE_FLOOR_PERCENT=51
JOIN_HOLD_SECONDS=120
NO_ANSWER_WAIT_SECONDS=60
CHAIN_CHUNK_LINKS=100
HELD_ROWS_PAGE=100

# A held row that is still not approved UNAPPROVED_AGE_LIMIT_SECONDS after
# it was stored is dropped by the validator holding it (docs/schemas.md
# section 21). A refused approval leaves such rows behind, and an account
# can send nothing through a validator that holds one against it. Every
# approval round is over long before this, so an older unapproved row is
# dead.
UNAPPROVED_AGE_LIMIT_SECONDS=300
