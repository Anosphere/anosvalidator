# One validator = one process = one of these files, named .env-validatorN
# where N is the validator's id. Start it with
#
#   VALIDATOR=N npm start
#
# Copy this file to .env-validator1 (and 2..5 for a local five-validator
# setup) and fill in every value. The real files are git-ignored.

# PostgreSQL. Variable names follow libpq, so psql reads this file too:
#   set -a && source .env-validator1 && set +a && psql
# Locally all five validators share one PostgreSQL server and one role and
# differ only in the database name (anos1..anos5). On a VM this is that
# machine's own PostgreSQL, and the database is usually just `anos`.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=anos1
PGUSER=anossoftware
PGPASSWORD=change-me

# Identity. VALIDATOR_ID is this validator's id in the validators table
# (db/validators.sql). PORT is where it listens: 3001..3005 locally so all
# five fit on one machine.
VALIDATOR_ID=1
PORT=3001

# Key for signing messages to the other validators. Validators sign with a
# P-256 key only; the post-quantum keys belong to accounts.
# The public key is raw bytes in lowercase hex: a 33-byte compressed P-256
# point, the same format the web app uses. The public half also goes in
# db/validators.sql so every validator can verify this one.
# The private key is PKCS#8 DER in lowercase hex; Node loads it with
#   createPrivateKey({ key: Buffer.from(hex, 'hex'), format: 'der', type: 'pkcs8' })
PUBLIC_KEY=
PRIVATE_KEY=

# Time locks on guarded and vault accounts, in minutes. A guardedAnosTransfer
# must be dated at least GUARDED_LOCK_MINUTES ahead and at most
# LOCK_OFFSET_MINUTES more than that; a vaultAnosTransfer the same with
# VAULT_LOCK_MINUTES. The web app dates a transfer the lock plus the offset
# ahead. Production: a week (10080), a month (43200) and 10 minutes. Local
# development: 1, 2 and 1, matched by the web app's constants.
GUARDED_LOCK_MINUTES=10080
VAULT_LOCK_MINUTES=43200
LOCK_OFFSET_MINUTES=10

# Stakes, in whole anos. An account takes a role by staking with the fund (a
# transferToFund naming the purpose); each STAKE_MIN_* is the least one such
# transfer may stake for that purpose, and the stake an account must hold to
# have the role. The same in production and locally.
STAKE_MIN_DAO_VOTE_ANOS=10
STAKE_MIN_MODERATOR_ANOS=1000
STAKE_MIN_ATTESTOR_ANOS=1000
STAKE_MIN_GUARDIAN_ANOS=1000
STAKE_MIN_VALIDATOR_ANOS=50000
STAKE_MIN_MASTER_POD_ANOS=500000

# Guardian votes on fund proposals. One vote per GUARDIAN_VOTE_ANOS of
# guardian stake, rounded down; a proposal passes when the votes for are at
# least GUARDIAN_VOTE_PERCENT of the votes cast, the proposer's counted as
# for; it is open for GUARDIAN_VOTE_MINUTES after its createdAt. Production:
# 1000, 70 and a week (10080). Local development: 1000, 70 and 1.
GUARDIAN_VOTE_ANOS=1000
GUARDIAN_VOTE_PERCENT=70
GUARDIAN_VOTE_MINUTES=10080
