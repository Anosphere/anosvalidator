# The machine file, .env: what differs per VM, three lines, written by
#
#   npm run make-keys -- --id <N>
#
# on the VM itself; nothing is typed by hand but the id. Everything shared
# by every VM is in network/testnet.env, which npm start loads first. This
# example is tracked; .env is not.

# This validator's id: its row in the validators table and in
# network/testnet.registry.json.
VALIDATOR_ID=1

# The application role's password, 32 hex characters from make-keys;
# scripts/setup-db.sh sets it on the role network/testnet.env names.
PGPASSWORD=<32 hex characters>

# The key file make-keys wrote: JSON { "privateKey" }, mode 0600, relative
# to the repo root or absolute. The server derives the public key from it.
KEY_FILE=./validator.key
