{
  "name": "anossoftware",
  "version": "1.0.0",
  "description": "A minimal Express server backed by PostgreSQL",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env-validator$VALIDATOR src/server.js",
    "dev": "node --watch --env-file=.env-validator$VALIDATOR src/server.js",
    "db:setup": "sh scripts/setup-db.sh",
    "db:reset": "sh scripts/reset-db.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "canonicalize": "^5.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
